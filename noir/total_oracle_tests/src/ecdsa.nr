//! The ECDSA entries against @noble/curves.
//!
//! The expected verdict is the documented one: the key passes
//! secpXXX_on_curve, the signature passes ecdsa_XX_sig_admissible (p - n <= r < n;
//! on secp256r1 also r != s and r + s != n), and @noble/curves verifies it
//! with low s required, on the 32-byte hash reduced mod n. The two flags are
//! public and checked against their own references too.
//!
//! Seeded cases: honest low-s signatures (RFC 6979, random keys and
//! hashes); a wrong hash; r or s with a flipped bit; high s (n - s); r or s
//! set to 0, 1, n - 1, n, n + 1, itself + n, a value in [n, 2^256),
//! 2^256 - 1, p - n - 1 or p - n; s exactly at the low-s boundary,
//! (n - 1) / 2 (low) or (n + 1) / 2 (high); signatures whose R.x is r + n;
//! signatures with u2 = r/s in {1, -1} (r == s, r + s == n) or u1 in
//! {0, 1, -1}; hash + n, hash 0, n and 2^256 - 1; u1 G + u2 P at infinity;
//! the keys G, -G, 2G and keys with the smallest and largest x found (x = 0
//! on P-256); random off-curve keys, a key with a flipped bit, the keys
//! (0, 1), (0, 2) and (5, 0), infinity encodings (0, 0), (p, 0), (0, p)
//! and all-0xff; x = 0 or y = 0 next to a valid coordinate; a valid key with
//! x + p; the negated key and the other curve's key; all-zero and all-0xff
//! signatures; and inputs whose unblinded black-box call has no proof on bb
//! 6.0.0 (fixed secp256k1 vectors: keys solved for a collision in the
//! multiplication's ladder, R at infinity and R = G with the last ladder step
//! colliding; secp256r1 keys -(1/4) H, (1/4) H and H for bb's offset generator
//! H, with u2 = 5). The textbook-valid vectors with r == s, r + s == n or
//! R.x = r + n are generated by choosing u1 and u2 and solving for the key
//! or the hash. The _fields cases are the same vectors with one byte in
//! three cases replaced by a value of 256 or more.

use total::ecdsa::{
    ecdsa_k1_sig_admissible, ecdsa_k1_verify, ecdsa_k1_verify_fields, ecdsa_r1_sig_admissible,
    ecdsa_r1_verify, ecdsa_r1_verify_fields,
};
use total::secp::{secp256k1_on_curve, secp256r1_on_curve};

global K1: Field = 1;
global R1: Field = 2;

pub struct EcdsaCase {
    pk_x: [u8; 32],
    pk_y: [u8; 32],
    sig: [u8; 64],
    hash: [u8; 32],
    key_on_curve: bool,
    sig_admissible: bool,
    valid: bool,
}

pub struct EcdsaFieldsCase {
    pk_x: [Field; 32],
    pk_y: [Field; 32],
    sig: [Field; 64],
    hash: [Field; 32],
    valid: bool,
}

#[oracle(ecdsa_case)]
unconstrained fn ecdsa_case_oracle(seed: Field, curve: Field) -> EcdsaCase {}

unconstrained fn ecdsa_case(seed: Field, curve: Field) -> EcdsaCase {
    ecdsa_case_oracle(seed, curve)
}

#[oracle(ecdsa_fields_case)]
unconstrained fn ecdsa_fields_case_oracle(seed: Field, curve: Field) -> EcdsaFieldsCase {}

unconstrained fn ecdsa_fields_case(seed: Field, curve: Field) -> EcdsaFieldsCase {
    ecdsa_fields_case_oracle(seed, curve)
}

#[test]
fn ecdsa_k1_verify_matches_reference(seed: Field) {
    // Safety: the oracle only supplies the case and the expected answers.
    let c = unsafe { ecdsa_case(seed, K1) };
    assert_eq(secp256k1_on_curve(c.pk_x, c.pk_y), c.key_on_curve);
    assert_eq(ecdsa_k1_sig_admissible(c.sig), c.sig_admissible);
    assert_eq(ecdsa_k1_verify(c.pk_x, c.pk_y, c.sig, c.hash), c.valid);
}

#[test]
fn ecdsa_r1_verify_matches_reference(seed: Field) {
    // Safety: the oracle only supplies the case and the expected answers.
    let c = unsafe { ecdsa_case(seed, R1) };
    assert_eq(secp256r1_on_curve(c.pk_x, c.pk_y), c.key_on_curve);
    assert_eq(ecdsa_r1_sig_admissible(c.sig), c.sig_admissible);
    assert_eq(ecdsa_r1_verify(c.pk_x, c.pk_y, c.sig, c.hash), c.valid);
}

#[test]
fn ecdsa_k1_verify_fields_matches_reference(seed: Field) {
    // Safety: the oracle only supplies the case and the expected answer.
    let c = unsafe { ecdsa_fields_case(seed, K1) };
    assert_eq(ecdsa_k1_verify_fields(c.pk_x, c.pk_y, c.sig, c.hash), c.valid);
}

#[test]
fn ecdsa_r1_verify_fields_matches_reference(seed: Field) {
    // Safety: the oracle only supplies the case and the expected answer.
    let c = unsafe { ecdsa_fields_case(seed, R1) };
    assert_eq(ecdsa_r1_verify_fields(c.pk_x, c.pk_y, c.sig, c.hash), c.valid);
}
